# Telegram Bot Konfiguration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Kommagetrennte Liste erlaubter Telegram-User-IDs (z.B. 12345678,87654321)
TELEGRAM_ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID

# MQTT-Broker & Zigbee2MQTT Konfiguration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_VALVE_TOPIC=zigbee2mqtt/garden_valve

# Geografische Koordinaten für den Wetter-Dienst (Voreingestellt auf Berlin)
LATITUDE=52.502778
LONGITUDE=13.515556

# Bewässerungsparameter
# Niederschlagsschwelle in mm (Regen der letzten + nächsten 24 Std), ab der Bewässerung
# übersprungen und im Chart "Kein Gießen nötig" angezeigt wird
RAIN_THRESHOLD_MM=2.0

# Hardware-Sicherheitslimit (Auto-Close/Inching) in Minuten (wird an das Ventil gesendet)
SAFETY_TIMEOUT_MINUTES=30

# Schwelle für Batteriewarnung in Prozent (z.B. 20 für 20%)
BATTERY_WARNING_THRESHOLD=20

# --- Inaktivitäts-Watchdog ---
WATCHDOG_ENABLED=true
WATCHDOG_VALVE_TIMEOUT_HOURS=24

# OTA-Update (nur auf Steuerzentrale und .env.prod — nie committen!)
GITHUB_PAT=github_pat_REPLACE_ME
GITHUB_REPO=g41nxe/telegram-GartenBot
