# Secrets und standortspezifische Werte — niemals committen, niemals durch OTA-Update überschreiben.
# Fachliche Einstellungen (Schwellwerte, Timeouts, MQTT) → config/garden.conf

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789

# Standort für Wettervorhersage (Open-Meteo) — persönlich, daher hier statt in garden.conf
LATITUDE=52.0
LONGITUDE=13.0

# GitHub OTA-Update (Feature 0011)
GITHUB_PAT=github_pat_...
GITHUB_REPO=username/garden

# Deployment (nur auf Windows-Entwicklungsmaschine nötig)
DEPLOY_PI_HOST=192.168.x.x
DEPLOY_PI_USER=pi
